  m_Script: {fileID: 11500000, guid: 20f0d826d695a47609677e1975e555e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  notes:
  - reference: {fileID: 1734665034}
    note: "Nothing else; it's (annoying) followers who always keep a \"Target Offset\"
      with you, enabled by the LazyFollow component.\n\nYou can configure Movement
      Speed, Position Follow, and Rotation Follow parameters on the component. Most
      parameters have tooltips \u2014 hover your mouse over them for details.\nAny
      object can be a follower: use a WorldSpace Canvas with a TextMeshPro component
      for floating UI labels, or attach LazyFollow to a mesh object for a companion-style
      effect \u2014 like Navi from The Legend of Zelda."
