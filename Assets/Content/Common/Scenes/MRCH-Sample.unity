MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 771449882}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 20f0d826d695a47609677e1975e555e3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  notes:
  - reference: {fileID: 529298557}
    note: "An InteractionTrigger driven by LookAtTrigger. It fires when two conditions
      are met simultaneously:\n\nYou are within the configured distance range\nThe
      angle between your camera's forward direction and the line from camera to trigger
      is within the configured angle range \u2014 i.e. you are actively looking at
      it\n\nThe exit event fires when you leave the distance range. Note that being
      in range but not looking at the trigger does not fire any event.\nSelect the
      object to visualize its detection zone via Gizmos: \U0001F440 indicates your
      gaze angle is within range, \U0001F4CF indicates you are within distance range."
